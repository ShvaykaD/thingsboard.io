---
// Pagination row for surfaces that pair the page-number nav with an
// items-per-page dropdown (IoT Hub). The selector is a SIBLING of the nav,
// not slotted inside it, so hiding the nav on a single page (or on a fetch
// error) leaves the per-page control reachable — without it, a user who
// raised the page size enough to collapse results to one page would lose the
// only control that could lower it again. This wrapper is the positioned
// ancestor for the selector's popup and owns the centred layout that
// used to live on the nav.
import Pagination from './Pagination.astro';
import PerPageSelector from './PerPageSelector.astro';

//
// Two modes, mirroring Pagination.astro's own:
//   * default (link)  — crawlable page anchors built from `basePath`; the page
//     knows its page count at build time.
//   * `interactive`   — event-emitting buttons, and the whole bar starts
//     hidden. For a surface whose page count only exists once the client has
//     asked the API (the IoT Hub creator profile narrowed to one `?type=`):
//     the build has no honest number to render, and a bar showing "1" before
//     the first fetch would be a claim rather than a state. The client unhides
//     it and calls updatePagination().
type Props = {
	perPage: number;
	/** Stable per-instance string (e.g. basePath) for unique selector ids. */
	idBase: string;
	class?: string;
} & (
	| {
			interactive?: false;
			currentPage: number;
			totalPages: number;
			basePath: string;
	  }
	| {
			interactive: true;
			currentPage?: never;
			totalPages?: never;
			basePath?: never;
	  }
);

// Narrow on Astro.props directly — TS can't narrow a union through destructuring.
const props = Astro.props;
const { perPage, idBase, class: className = '' } = props;
const interactive = props.interactive === true;
---

<div
	class:list={['tb-pagination-bar', className]}
	data-tb-pagination-bar
	hidden={interactive}
>
	{
		interactive ? (
			<Pagination mode="interactive" hidden />
		) : (
			<Pagination
				mode="link"
				currentPage={props.currentPage}
				totalPages={props.totalPages}
				basePath={props.basePath}
			/>
		)
	}
	<PerPageSelector perPage={perPage} idBase={idBase} />
</div>

<style is:global lang="scss">
	@use '../../styles/_variables.scss' as *;

	.tb-pagination-bar {
		position: relative;
		// Establishes a stacking context (z-index !== auto) so the per-page
		// popup floats above the page sections that follow in DOM order.
		z-index: 5;
		display: flex;
		align-items: center;
		justify-content: center;
		min-height: 40px;

		// The nav fills the row and centres its numbers; the per-page selector is
		// taken out of flow and pinned to the right edge (in PerPageSelector.astro),
		// so it never shifts the centred numbers.
		.tb-pagination {
			flex: 1 1 0;
		}

		&[hidden] {
			display: none;
		}
	}
</style>
