---
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import {
	GROUPED_SECTION_SIZE,
	IOT_HUB_API_URL,
	IOT_HUB_CATEGORIES,
	IOT_HUB_STRINGS,
	CREATOR_PAGE_SIZE,
	creatorViewSchema,
	isNumericSlug,
	type IotHubItemType,
	type ListingView,
	resolveAvatar,
	type CreatorView,
} from '@models/iot-hub';
import BaseLayout from '@layouts/BaseLayout.astro';
import GroupedResultsPanel from '@components/IotHub/GroupedResultsPanel.astro';
import { toSections, type GroupedSection } from '@components/IotHub/iot-hub-grouping';
import CreatorHero from '@components/IotHub/CreatorHero.astro';
import IotHubRuntimeConfig from '@components/IotHub/IotHubRuntimeConfig.astro';
import SearchFilterBar from '@components/IotHub/SearchFilterBar.astro';
import { fetchWithRetry } from '@util/fetch-utils';
import { recordSitemapLastmod } from '@util/sitemap-lastmod';

export const getStaticPaths = (async () => {
	// Defined inside getStaticPaths: Astro extracts and runs getStaticPaths in
	// an isolated scope, so it can only reference module imports — NOT other
	// frontmatter declarations.
	const loadProfile = async (id: string): Promise<CreatorView | null> => {
		try {
			const res = await fetchWithRetry(`${IOT_HUB_API_URL}/api/creators/${id}/profile`);
			return creatorViewSchema.parse(await res.json());
		} catch (e) {
			if (import.meta.env.DEV) {
				const msg = e instanceof Error ? e.message : String(e);
				console.warn(`[iot-hub] creator profile fetch failed in dev for ${id}: ${msg}`);
				return null;
			}
			throw e;
		}
	};

	const categories = await getCollection('iotHubCategories');
	const byId = new Map(categories.map((c) => [c.id, c.data]));

	// Re-shape the per-category collection into a per-creator, per-type stream —
	// the loader already fetches the full catalog (loops until hasNext is
	// false), so no additional API call is needed. Grouping by item type is what
	// the profile renders; the category slug a card links into is derived from
	// that type by GroupedSection, so it is not carried here.
	// Pure-numeric slugs excluded to mirror [slug].astro.
	const byCreator = new Map<string, Map<IotHubItemType, ListingView[]>>();
	for (const cat of IOT_HUB_CATEGORIES) {
		const items = byId.get(cat.slug)?.items ?? [];
		for (const item of items) {
			if (isNumericSlug(item.slug)) continue;
			if (!item.creatorId) continue;
			const byType = byCreator.get(item.creatorId) ?? new Map<IotHubItemType, ListingView[]>();
			const arr = byType.get(cat.itemType) ?? [];
			arr.push(item);
			byType.set(cat.itemType, arr);
			byCreator.set(item.creatorId, byType);
		}
	}

	const ids = [...byCreator.keys()];
	// One profile fetch per creator.
	const profiles = new Map<string, CreatorView | null>();
	await Promise.all(
		ids.map(async (id) => {
			profiles.set(id, await loadProfile(id));
		})
	);

	// One route per creator. The profile is a grouped answer — one screen, four
	// of each type, the section header the way into the rest — so the old
	// `/iot-hub/creator/<id>/2/`… pages are gone and redirected back here from
	// src/data/redirects.ts.
	return ids.map((id) => {
		const byType = byCreator.get(id)!;
		let total = 0;
		for (const arr of byType.values()) total += arr.length;
		const profile = profiles.get(id) ?? null;
		const categoryLabels = IOT_HUB_CATEGORIES.filter((c) => byType.has(c.itemType)).map(
			(c) => c.label
		);
		// installCount DESC, createdTime DESC tie-break, capped per type — the
		// order the runtime's own grouped request comes back in. Items arrived
		// sorted per category by the loader; this re-sorts inside each section
		// so the static and the fetched view agree.
		const sections = toSections(
			[...byType].map(([itemType, items]) => {
				const ranked = [...items].sort((a, b) => {
					const ic = (b.installCount ?? 0) - (a.installCount ?? 0);
					if (ic !== 0) return ic;
					return (b.createdTime ?? 0) - (a.createdTime ?? 0);
				});
				return {
					itemType,
					items: ranked.slice(0, GROUPED_SECTION_SIZE),
					total: ranked.length,
				};
			}),
			// The profile's section headers must stay on the profile: "Widgets ›"
			// here means this creator's widgets, not every widget in the Hub.
			{ creatorId: id }
		);
		return {
			params: { id, page: undefined },
			props: { profile, sections, total, categoryLabels },
		};
	});
}) satisfies GetStaticPaths;

interface Props {
	profile: CreatorView | null;
	sections: GroupedSection[];
	total: number;
	categoryLabels: string[];
}

const { profile, sections, total, categoryLabels } = Astro.props as Props;
const { id } = Astro.params;

// <lastmod> from the most recent API `updatedTime` among this page's listings.
recordSitemapLastmod(
	Astro.url.pathname,
	sections.flatMap((section) => section.items.map((item) => item.updatedTime))
);

const first = sections[0]?.items[0];
const name = profile?.displayName ?? first?.creatorDisplayName ?? 'ThingsBoard';
const avatarUrl = resolveAvatar(profile?.avatarUrl ?? first?.creatorAvatarUrl ?? null);
const verified = profile?.verified ?? first?.creatorVerified ?? false;
const count = profile?.publishedListingCount ?? total;
const basePath = `/iot-hub/creator/${id}/`;

const title = `${name} | IoT Hub | ThingsBoard`;
const categoryList =
	categoryLabels.length > 0
		? new Intl.ListFormat('en', { type: 'conjunction' }).format(categoryLabels)
		: '';
const verifiedNote = verified ? ' Verified creator profile.' : '';
const description = categoryList
	? `Explore ${name}'s IoT components on the ThingsBoard IoT Hub — ${categoryList}.${verifiedNote}`
	: `Explore ${name}'s IoT solution components on the ThingsBoard IoT Hub.${verifiedNote}`;
---

<BaseLayout title={title} description={description}>
	<div
		class="iot-hub-creator"
		data-iot-hub-search-root
		data-creator-id={id}
		data-base-path={basePath}
		data-page-size={CREATOR_PAGE_SIZE}
		data-grouped
	>
		<div class="iot-hub-creator__center">
			<div class="iot-hub-creator__container">
				<CreatorHero
					name={name}
					avatarUrl={avatarUrl}
					verified={verified}
					bio={profile?.description}
					website={profile?.website}
					email={profile?.contactEmail}
					github={profile?.githubUrl}
					linkedin={profile?.linkedinUrl}
					twitter={profile?.twitterUrl}
				/>
			</div>
		</div>
		<div class="iot-hub-creator__divider"></div>
		<div class="iot-hub-creator__center">
			<div class="iot-hub-creator__container">
				<div class="iot-hub-creator__items" data-search-items>
					<SearchFilterBar
						heading={`${IOT_HUB_STRINGS.creatorPage.publishedItems} (${count})`}
						searchPlaceholder={IOT_HUB_STRINGS.creatorPage.searchPlaceholder}
						totalResults={total}
						showRelevance
					/>
					<GroupedResultsPanel
						sections={sections}
						showCreator={false}
						clearHref={basePath}
						paginate={{ perPage: CREATOR_PAGE_SIZE, idBase: basePath }}
					/>
				</div>
			</div>
		</div>
		<IotHubRuntimeConfig />
	</div>
</BaseLayout>

<style lang="scss">
	@use '../../../../styles/_variables.scss' as *;
	@use '../../../../styles/_iot-hub.scss' as *;

	.iot-hub-creator {
		@include iot-hub-hairline-token;
	}

	.iot-hub-creator__center {
		@include iot-hub-center;
	}

	.iot-hub-creator__container {
		@include iot-hub-container;
	}

	.iot-hub-creator__divider {
		@include iot-hub-divider;
	}

	.iot-hub-creator__items {
		@include iot-hub-listing-column;
	}

</style>

<script>
	import { initDynamicSearch } from '@components/IotHub/iot-hub-dynamic-search';
	initDynamicSearch();
</script>
