---
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import {
	GROUPED_SECTION_SIZE,
	IOT_HUB_CATEGORIES,
	IOT_HUB_STRINGS,
	isNumericSlug,
	type IotHubItemType,
	type ListingView,
} from '@models/iot-hub';
import BaseLayout from '@layouts/BaseLayout.astro';
import GroupedResultsPanel from '@components/IotHub/GroupedResultsPanel.astro';
import { toSections } from '@components/IotHub/iot-hub-grouping';
import type { GroupedSection } from '@components/IotHub/iot-hub-grouping';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import IotHubRuntimeConfig from '@components/IotHub/IotHubRuntimeConfig.astro';
import SearchFilterBar from '@components/IotHub/SearchFilterBar.astro';
import { recordSitemapLastmod } from '@util/sitemap-lastmod';

const T = IOT_HUB_STRINGS.searchPage;

// One route. The grouped answer is one screen — the way to more of one type is
// the section header, not a second page — so the old `/iot-hub/search/2/`…
// pages are gone. They were indexed, so they are redirected here from
// src/data/redirects.ts (DYNAMIC_REDIRECTS, "IoT Hub — search pagination").
export const getStaticPaths = (async () => {
	const categories = await getCollection('iotHubCategories');
	const byId = new Map(categories.map((c) => [c.id, c.data]));

	const byType = new Map<IotHubItemType, ListingView[]>();
	let total = 0;
	for (const cat of IOT_HUB_CATEGORIES) {
		const items = (byId.get(cat.slug)?.items ?? []).filter((item) => !isNumericSlug(item.slug));
		if (items.length === 0) continue;
		byType.set(cat.itemType, items);
		total += items.length;
	}

	// Match the backend's order for
	// `?sortProperty=installCount&sortOrder=DESC&grouped=true` — installCount
	// DESC, then createdTime DESC as tie-break, capped per type — so the static
	// build and the first runtime refetch surface the same items in the same
	// order. Section order, labels, "+N more" and hrefs come from toSections,
	// the same code the runtime renderer uses.
	const sections = toSections(
		[...byType].map(([itemType, items]) => {
			const ranked = [...items].sort((a, b) => {
				const ic = (b.installCount ?? 0) - (a.installCount ?? 0);
				if (ic !== 0) return ic;
				return (b.createdTime ?? 0) - (a.createdTime ?? 0);
			});
			return { itemType, items: ranked.slice(0, GROUPED_SECTION_SIZE), total: ranked.length };
		})
	);

	return [{ params: { page: undefined }, props: { sections, total } }];
}) satisfies GetStaticPaths;

interface Props {
	sections: GroupedSection[];
	total: number;
}

const { sections, total } = Astro.props as Props;
const searchText = '';

// <lastmod> from the newest listing `updatedTime` on this page.
recordSitemapLastmod(
	Astro.url.pathname,
	sections.flatMap((section) => section.items.map((item) => item.updatedTime))
);

const title = 'Search | IoT Hub | ThingsBoard';
const description =
	'Search the ThingsBoard IoT Hub catalogue of devices, widgets, rule chains and more.';
---

<BaseLayout title={title} description={description}>
	<div
		class="iot-hub-search"
		data-iot-hub-search-root
		data-base-path="/iot-hub/search/"
		data-grouped
	>
		<div class="iot-hub-search__center">
			<div class="iot-hub-search__container">
				<div class="iot-hub-search__breadcrumb">
					<Breadcrumbs
						items={[
							{ label: T.breadcrumbRoot, href: '/iot-hub/' },
							{ label: T.breadcrumbCurrent },
						]}
					/>
				</div>
				<div class="iot-hub-search__items" data-search-items>
					<SearchFilterBar
						headingAs="h1"
						heading={T.headingEmpty}
						headingPrefix={T.headingPrefix}
						searchText={searchText}
						searchPlaceholder={T.searchPlaceholder}
						totalResults={total}
						showRelevance
					/>
					<GroupedResultsPanel sections={sections} titleAs="h2" />
				</div>
			</div>
		</div>
		<IotHubRuntimeConfig />
	</div>
</BaseLayout>

<style lang="scss">
	@use '../../../styles/_variables.scss' as *;
	@use '../../../styles/_iot-hub.scss' as *;

	.iot-hub-search {
		@include iot-hub-hairline-token;
	}

	.iot-hub-search__center {
		@include iot-hub-center;
	}

	.iot-hub-search__container {
		@include iot-hub-container;
	}

	.iot-hub-search__breadcrumb {
		padding: calc(#{$header-height} + 40px) 16px 0;

		@include media-down(sm) {
			padding: calc(#{$header-height} + 40px) 12px 0;
		}
	}

	.iot-hub-search__items {
		@include iot-hub-listing-column;
	}

</style>

<script>
	import { initDynamicSearch } from '@components/IotHub/iot-hub-dynamic-search';
	initDynamicSearch();
</script>
